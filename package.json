{
	"name": "n8n-nodes-spicrawl",
	"version": "0.1.2",
	"description": "Spicrawl n8n node for web scraping: scrape websites to Markdown, HTML or JSON, extract data with CSS selectors, batch-scrape URLs and use it as an AI Agent tool",
	"license": "MIT",
	"homepage": "https://github.com/OfficialSpicrawl/n8n-nodes-spicrawl#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"spicrawl",
		"web-scraping",
		"web-scraper",
		"scraper",
		"crawler",
		"markdown",
		"data-extraction",
		"javascript-rendering",
		"ai-agent",
		"llm",
		"rag",
		"automation",
		"workflow"
	],
	"author": {
		"name": "Spicrawl",
		"email": "support@spicrawl.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OfficialSpicrawl/n8n-nodes-spicrawl.git"
	},
	"bugs": {
		"url": "https://github.com/OfficialSpicrawl/n8n-nodes-spicrawl/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node test/smoke.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SpicrawlApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Spicrawl/Spicrawl.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
